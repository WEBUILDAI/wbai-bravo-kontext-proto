# Vorlage für lokale Entwicklung. Nach .env kopieren, .env nie committen.
# Pulumi (infra/): Login gegen das Azure-Blob-Backend
AZURE_STORAGE_ACCOUNT=stwbaibravostateproto
# PULUMI_CONFIG_PASSPHRASE=  # nur falls Stack mit passphrase-Secrets-Provider angelegt wurde

# Wissens-MCP (server/)
# Bearer-Token; in Azure aus Key Vault (Secret bravo-kontext-token). Lokal beliebiger Wert.
BRAVO_KONTEXT_TOKEN=
# Erlaubte Host-Header (kommagetrennt, Port-Wildcard erlaubt: localhost:*). * schaltet die Prüfung ab.
BRAVO_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Offline-Modus: lokaler Klon von wbai-bravo-wissen-proto (hat Vorrang vor GitHub)
WISSEN_LOCAL_PATH=
WISSEN_REPO=WEBUILDAI/wbai-bravo-wissen-proto
WISSEN_REF=main
SAMPLE_REPO=WEBUILDAI/wbai-bravo-sample-proto
# GitHub App A12; ohne alle drei Werte sind propose und die Vorschlags-Tools gestubbt
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Login der App als Kommentar-Autor (für Rückfrage-Erkennung und Guard in bravo-triage.yml)
BRAVO_BOT_LOGIN=wbai-bravo-mcp-proto[bot]
# Optional: Ranking per Claude; ohne Key reiner Keyword-Score
ANTHROPIC_API_KEY=
BRAVO_RANKING_MODEL=claude-haiku-4-5-20251001
# Optional: Ziel für POST /notify; ohne Wert antwortet /notify mit 202 noop
TEAMS_WEBHOOK_URL=
LOG_FORMAT=json
LOG_LEVEL=INFO
PORT=8000
